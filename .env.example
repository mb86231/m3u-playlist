# Copy to .env or, easier, enter everything on the Settings page after first
# start — the UI writes this file for you (mode 0600).

# Your M3U playlist URL (provided by your streaming provider).
M3U_URL=

# One of the two TMDB credentials is enough for metadata lookup.
TMDB_BEARER_TOKEN=
TMDB_API_KEY=

# TMDB language tag, e.g. en-US or de-DE.
METADATA_LANGUAGE=en-US

# Runtime paths — only override when not using the default layout.
DATA_DIR=/var/lib/apps/m3u-library
DATABASE_PATH=/var/lib/apps/m3u-library/app.db

# Protects POST /api/refresh and /api/metadata/* endpoints for external
# clients (the web UI uses a login session instead). Leave empty to disable
# authentication (not recommended for public deployments) — you can also
# generate a key on the Settings page.
API_KEY=

# Set to true when serving behind an HTTPS reverse proxy so session cookies
# get the Secure flag.
SECURE_COOKIES=false
